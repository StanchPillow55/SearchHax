# Base URL the browser uses for API calls. Empty = same origin (/api via the dev proxy).
VITE_API_BASE_URL=
# Where the dev/preview proxy forwards /api. Point this at the FastAPI exploration service.
SEARCHHAX_API_PROXY_TARGET=http://127.0.0.1:8000
# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=20000
# Resuming a branch runs real (billable) research. Leave false unless explicitly authorised.
VITE_ALLOW_BILLABLE_RESEARCH=false
