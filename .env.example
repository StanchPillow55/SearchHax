# Copy to .env and fill in locally. Never commit .env.

# Telem. The SDK defaults to https://router.telem.ai when TELEM_BASE_URL is unset.
# The hackathon notes also mention https://hack.telem.ai/api — set TELEM_BASE_URL to use that router.
TELEM_API_KEY=
TELEM_BASE_URL=https://router.telem.ai

# Optional. Used only when a Telem fetch returns empty page content.
TAVILY_API_KEY=

# OpenAI-compatible extraction. If LLM_API_KEY is empty and OPENAI_API_KEY is set, the latter is used.
# A base URL on localhost, 127.0.0.1, or ::1 is not called: measured local models miss the 12s deadline.
# Set LLM_FORCE_LOCAL=1 to send that request anyway. Disclosed-fact extraction still runs either way.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_FORCE_LOCAL=

# Convergence controller owned by the other workstream. Exploration only POSTs here.
CONVERGENCE_URL=http://127.0.0.1:8000/api/convergence/evaluate

# DRY_RUN=1 replays cached provider responses and synthetic fixtures. It does not call the network.
DRY_RUN=
